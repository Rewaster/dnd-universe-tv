<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad focus must be obvious from the couch: focused = filled gold with a light ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFE0BC45" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/accent" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
</selector>
